# ---------------------------------------------------------------------------
# CmdBook — files that must NOT be pushed to a remote repository
# ---------------------------------------------------------------------------

# Build output. Rebuild with ./build.sh after cloning.
dist/
.build/
*.app/
DerivedData/

# Distribution archives (generated by the packaging commands in README)
*.dmg
*.zip
*.pkg
*.ipa

# Icon intermediates (Resources/CmdBook.icns itself IS committed)
CmdBook.iconset/
*.iconset/

# Runtime data: snapshots live in ~/Library/Application Support/CmdBook/
data/
/tools.json
/saved.json

# Credentials and signing material — never commit these.
.env
.env.*
*.p12
*.pem
*.key
*.mobileprovision
*credentials*.json
*app-specific-password*

# macOS / Finder metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Xcode / editor user state
*.xcuserstate
*.xcuserdatad/
xcuserdata/
.idea/
.vscode/
*.swp
*~

# Logs and temporary files
*.log
*.tmp
*.orig
*.rej
*.bak

# Legacy scan side-effects (kept for safety; CWD isolation now prevents them)
.backup/
.merged/
.new/
.orig/
.patch/
orb.db/
realdoc/
seedfile
patcheck.tmp
result-enc.txt
rsa_priv.txt
rsa_pub.txt
.mib2c-updaterc
